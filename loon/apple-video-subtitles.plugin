#!name=Apple TV 中文字幕 + Fitness+ 双语 + F1 AI 实验
#!desc=20261124c；F1 独立等待上限及逐句校验重试，减少英文回退；Fitness+ 选择英文显示双语；保持 Music 兼容

# Generated by tools/generate_loon.py. Do not edit.
# One UTS response script routes static subtitles before F1 AI.

[Argument]
f1_wait = input,15,type=number,tag=F1 翻译最长等待秒数,desc=2至15秒；F1 独立等待上限，默认15秒以减少英文回退
deepseek_key = input,"",type=string,tag=DeepSeek API Key,desc=仅在 Loon 本地填写密钥，勿分享含密钥的配置
deepseek_model = input,"deepseek-flash",type=string,tag=DeepSeek 模型,desc=关闭思考模式按需翻译，首次播放可能需要等待
deepseek_wait = input,8,type=number,tag=翻译最长等待秒数,desc=2至15秒，超时立即放行原英文字幕

[Rewrite]

[Script]
http-response ^https:\/\/uts-api\.itunes\.apple\.com\/uts\/(?:v1|v2|v3)\/ script-path=https://raw.githubusercontent.com/julianaexx/apple-video-subtitles/main/scripts/f1-cc-deepseek-0687e67fd4a2b8f34c92c37210bec3a0ddd311132be91468a6a4ea56647ec4d0.js,requires-body=true,max-size=0,timeout=2,tag=F1.CC.Register,argument={deepseek_key,deepseek_model,deepseek_wait,f1_wait},enable=true
http-response ^https:\/\/linear-(?:ak|ap|fa)-[a-z0-9-]+\.tv\.apple\.com\/Content\/HLS_CBC\/CatchUp\/Channel\([^\s]+\/Stream\(\d+\)\/[^\s?]*\.m3u8(?:\?.*)?$ script-path=https://raw.githubusercontent.com/julianaexx/apple-video-subtitles/main/scripts/f1-cc-deepseek-0687e67fd4a2b8f34c92c37210bec3a0ddd311132be91468a6a4ea56647ec4d0.js,requires-body=true,max-size=2097152,timeout=2,tag=F1.CC.Media,argument={deepseek_key,deepseek_model,deepseek_wait,f1_wait},enable=true
http-response ^https:\/\/linear-(?:ak|ap|fa)-[a-z0-9-]+\.tv\.apple\.com\/Content\/HLS_CBC\/CatchUp\/Channel\([^\s]+\/Stream\(\d+\)\/Segment\(\d+\)\.m4v(?:\?.*)?$ script-path=https://raw.githubusercontent.com/julianaexx/apple-video-subtitles/main/scripts/f1-cc-deepseek-0687e67fd4a2b8f34c92c37210bec3a0ddd311132be91468a6a4ea56647ec4d0.js,requires-body=true,binary-body-mode=true,max-size=12582912,timeout=2,tag=F1.CC.Observe,argument={deepseek_key,deepseek_model,deepseek_wait,f1_wait},enable=true
http-request ^https:\/\/hls-amt\.itunes\.apple\.com\/__loon_f1_cc\/v1\/(?:[a-f0-9]+\/(?:master|index)\.m3u8|segment\.vtt\?src=[^&]+)$ script-path=https://raw.githubusercontent.com/julianaexx/apple-video-subtitles/main/scripts/f1-cc-deepseek-0687e67fd4a2b8f34c92c37210bec3a0ddd311132be91468a6a4ea56647ec4d0.js,timeout=22,tag=F1.CC.Subtitles,argument={deepseek_key,deepseek_model,deepseek_wait,f1_wait},enable=true

# Native Fitness+ English captions display Chinese and English in the existing track.
http-response ^https:\/\/hls-svod\.itunes\.apple\.com\/itunes-assets\/[A-Za-z0-9_./-]*P\d+_A\d+_en_subtitles[^/?#]*-\d+\.(?:webvtt|vtt)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/julianaexx/apple-video-subtitles/main/scripts/fitness-deepseek-33ab3e13bc2bd1ff6a5faee01d36249f5f7f34743c663098c14c6d9a824cab19.js,requires-body=true,max-size=65536,timeout=18,tag=Fitness.DeepSeek.VTT,argument={deepseek_key,deepseek_model,deepseek_wait},enable=true
http-request ^https:\/\/hls-svod\.itunes\.apple\.com\/__loon_fitness_deepseek\/v1\/(?:index\.m3u8|segment\.vtt)\?src=[^&]+$ script-path=https://raw.githubusercontent.com/julianaexx/apple-video-subtitles/main/scripts/fitness-deepseek-33ab3e13bc2bd1ff6a5faee01d36249f5f7f34743c663098c14c6d9a824cab19.js,timeout=2,tag=Fitness.DeepSeek.LegacyRedirect,argument={deepseek_key,deepseek_model,deepseek_wait},enable=true

